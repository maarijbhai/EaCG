# Gradle / build output
.gradle/
build/
*/build/
captures/
.externalNativeBuild/
.cxx/

# Machine-specific — contains YOUR SDK path, will break on other machines
local.properties

# IDE
*.iml
.idea/
!.idea/codeStyles/
!.idea/inspectionProfiles/

# Signing keys — never commit these
*.jks
*.keystore

# OS junk
.DS_Store
Thumbs.db

__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

data/
*.h5
*.tflite
# ...except the models the app ships (b3 FP16 + INT8f, ~0.8 MB each): without
# them a clone builds an app whose learned tracer cannot load.
!android/app/src/main/assets/ml/*.tflite
*.pt
*.onnx

# Downloaded dataset (wget -r artefact) — never commit
physionet.org/

# Third-party tools cloned outside the repo (ecg-image-kit); defensive
vendor/

# Generated print targets — reproducible from make_print_target.py
out/

# Thesis write-up and working notes: kept locally, not published
CLAUDE.md
CHANGES.txt
previous_thesis.md
prompt_b5_and_photo.md
convert.py
archive/
docs/*
!docs/ml_plan.md
!docs/classifier_training.md
!docs/functional_requirements.tex
!docs/functional_requirements_standalone.tex
